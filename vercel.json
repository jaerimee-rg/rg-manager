{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "face_engine/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "excludeFiles": "{client/**,server/**,docs/**,screenshots/**,face_engine/tests/**,face_engine/.models/**,*.md}"
      }
    }
  ],
  "routes": [
    { "src": "/api/face-engine(/.*)?", "dest": "face_engine/index.py" },
    { "src": "/api(/.*)?", "dest": "server/server.js" },
    { "src": "/assets/(.*)", "dest": "/client/assets/$1" },
    { "src": "/(logo-mark|og-image|icon-192|icon-512)\\.png", "dest": "/client/$1.png" },
    {
      "src": "/sw\\.js",
      "headers": { "Cache-Control": "no-cache", "Content-Type": "text/javascript; charset=utf-8" },
      "dest": "/client/sw.js"
    },
    {
      "src": "/manifest\\.webmanifest",
      "headers": { "Content-Type": "application/manifest+json" },
      "dest": "/client/manifest.webmanifest"
    },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ]
}
